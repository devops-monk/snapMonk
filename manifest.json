{
  "manifest_version": 3,
  "name": "SnapMonk — Screenshot & Annotation Tool",
  "short_name": "SnapMonk",
  "version": "1.0.3",
  "description": "Capture, annotate & share screenshots instantly. Full-page capture, rich editor & DevOps integrations — by DevOps-Monk.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SnapMonk"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "contextMenus",
    "tabCapture"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/editor/editor.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "capture-visible": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capture visible area"
    },
    "capture-fullpage": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Capture full page"
    },
    "capture-region": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Capture selected region"
    }
  }
}
